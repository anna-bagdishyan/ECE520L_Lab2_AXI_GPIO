/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xgpio.h"

#define LED_DELAY (1000000000)


int main()
{
	XGpio GpioLED;
	XGpio GpioRGB;
	XGpio GpioSW;

	int StatusLED, StatusRGB, StatusSW;
	uint32_t switches;
	int led_count = 0;
	volatile int delay;

    init_platform();

    xil_printf("Hello World\r\n");

    // Refer to xparameters.h
    StatusLED = XGpio_Initialize(&GpioLED, XPAR_AXI_GPIO_0_DEVICE_ID);
    StatusRGB = XGpio_Initialize(&GpioRGB, XPAR_AXI_GPIO_1_DEVICE_ID);
    StatusSW = XGpio_Initialize(&GpioSW, XPAR_AXI_GPIO_2_DEVICE_ID);

    if ((StatusLED != XST_SUCCESS) || (StatusRGB != XST_SUCCESS) || (StatusSW != XST_SUCCESS))
    {
    	xil_printf("GPIO Initialization Failed.\r\n");
    	return XST_FAILURE;
    }
    xil_printf("GPIO has successfully initialized.\r\n");

    // Refer to xgpio.c for function implementation
    XGpio_SetDataDirection(&GpioLED, 1, 0);
    XGpio_SetDataDirection(&GpioRGB, 1, 0);
    XGpio_SetDataDirection(&GpioSW, 1, 0xF);

    while(1)
    {
        switches = XGpio_DiscreteRead(&GpioSW, 1);

        xil_printf("Switches: 0x%X\r\n", switches);

        for (delay = 0; delay < 10000000; delay++);
    }
}

/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xgpio.h"

#define LED_DELAY (1000000000)


int main()
{
	XGpio GpioLED;
	XGpio GpioRGB;
	XGpio GpioSW;

	int StatusLED, StatusRGB, StatusSW;
	uint32_t switches;
	int led_count = 0;
	volatile int delay;

    init_platform();

    xil_printf("Hello World\r\n");

    // Refer to xparameters.h
    StatusLED = XGpio_Initialize(&GpioLED, XPAR_AXI_GPIO_0_DEVICE_ID);
    StatusRGB = XGpio_Initialize(&GpioRGB, XPAR_AXI_GPIO_1_DEVICE_ID);
    StatusSW = XGpio_Initialize(&GpioSW, XPAR_AXI_GPIO_2_DEVICE_ID);

    if ((StatusLED != XST_SUCCESS) || (StatusRGB != XST_SUCCESS) || (StatusSW != XST_SUCCESS))
    {
    	xil_printf("GPIO Initialization Failed.\r\n");
    	return XST_FAILURE;
    }
    xil_printf("GPIO has successfully initialized.\r\n");

    // Refer to xgpio.c for function implementation
    XGpio_SetDataDirection(&GpioLED, 1, 0);
    XGpio_SetDataDirection(&GpioRGB, 1, 0);
    XGpio_SetDataDirection(&GpioSW, 1, 0xF);

    while(1)
    {
    	switches = XGpio_DiscreteRead(&GpioSW, 1);
   		if (switches == 0x1)
    	{
    		// LED0 & Red
    		XGpio_DiscreteWrite(&GpioLED, 1, 0x1);
    		xil_printf("LED0 high\r\n");

    		XGpio_DiscreteWrite(&GpioRGB, 1, 0x1);
    		xil_printf("RGB red\r\n");

    		// wait a small amount of time
    		    	for (delay = 0; delay < LED_DELAY; delay++);
    	}
    	else if (switches == 0x2)
    	{
    	    // LED1 & green
    		XGpio_DiscreteWrite(&GpioLED, 1, 0x2);
    		xil_printf("LED1 high\r\n");

    		XGpio_DiscreteWrite(&GpioRGB, 1, 0x2);
    		xil_printf("RGB green\r\n");

    		// wait a small amount of time
    		    	for (delay = 0; delay < LED_DELAY; delay++);
    	}
    	else if (switches == 0x4)
    	{
    	    // LED2 & blue
    		XGpio_DiscreteWrite(&GpioLED, 1, 0x4);
    		xil_printf("LED2 high\r\n");

    		XGpio_DiscreteWrite(&GpioRGB, 1, 0x4);
    		xil_printf("RGB blue\r\n");
    	}
    	else if (switches == 0x8)
    	{
    	    // LED3 & white
    		XGpio_DiscreteWrite(&GpioLED, 1, 0x8);
    		xil_printf("LED3 high\r\n");

    		XGpio_DiscreteWrite(&GpioRGB, 1, 0x7);
    		xil_printf("RGB white\r\n");

    		// wait a small amount of time
    		    	for (delay = 0; delay < LED_DELAY; delay++);
   		}
   		else if (switches == 0x3) // sw 1 & sw 2
   		{
   		    // binary counter
    		XGpio_DiscreteWrite(&GpioLED, 1, led_count);
    		XGpio_DiscreteWrite(&GpioLED, 1, 0x0);

    		for (delay = 0; delay < LED_DELAY; delay++)
    		{
    			led_count++;
   				if (led_count > 0xF)
    			{
    					led_count = 0;
    			}
    		}
    	}
    	else if (switches == 0xC) // sw 3 & sw 4
    	{
    		// ring counter

    	}
    	else
    	{
    		// all off
    		XGpio_DiscreteWrite(&GpioLED, 1, 0x0);
    		xil_printf("LED low\r\n");

    		XGpio_DiscreteWrite(&GpioRGB, 1, 0x0);
    		xil_printf("RGB low\r\n");
    	}
    }
}
